; AI Passport (ESP32-C3) USB serial port for Windows 7 / 8 / 8.1.
; Binds the in-box usbser.sys to interface 0 (CDC) of the ESP32-C3 USB-JTAG/Serial unit.
; Interface 2 (JTAG) is not touched. Windows 10 and later do not need this file.

[Version]
Signature="$Windows NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%MFG%
DriverVer=11/12/2026,1.0.0.0

[Manufacturer]
%MFG%=DeviceList,NTx86,NTamd64

[DeviceList.NTx86]
%DESC%=DriverInstall,USB\VID_303A&PID_1001&MI_00

[DeviceList.NTamd64]
%DESC%=DriverInstall,USB\VID_303A&PID_1001&MI_00

[DriverInstall]
Include=mdmcpq.inf
CopyFiles=FakeModemCopyFileSection
AddReg=DriverInstall.AddReg

[DriverInstall.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,usbser.sys
HKR,,EnumPropPages32,,"MsPorts.dll,SerialPortPropPageProvider"

[DriverInstall.Services]
Include=mdmcpq.inf
AddService=usbser,0x00000002,DriverService

[DriverService]
DisplayName=%SERVICE%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\usbser.sys
LoadOrderGroup=Base

[Strings]
MFG="FoloToy"
DESC="AI Passport USB Serial"
SERVICE="USB Serial driver"
